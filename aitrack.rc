// Windows resources of aiTrack.exe: the icon (Explorer, taskbar, Alt+Tab) and the version
// information. build.rs copies this to OUT_DIR with VERSION_STR / VERSION_NUM replaced and compiles it with embed-resource.
#define VS_VERSION_INFO 1

1 ICON "assets/icon/aitrack.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_NUM
PRODUCTVERSION VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", "aiTrack"
            VALUE "FileDescription", "aiTrack - AI plan usage tracker"
            VALUE "FileVersion", VERSION_STR
            VALUE "ProductVersion", VERSION_STR
            VALUE "InternalName", "aitrack"
            VALUE "OriginalFilename", "aitrack.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
